<?xml version="1.0" encoding="utf-8"?>
<!-- Thick rounded track: warm gradient for the dimmed part. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="8dp">
        <shape>
            <solid android:color="@color/dusk_track" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="8dp">
        <clip>
            <shape>
                <gradient android:angle="0" android:startColor="#FFFDBA7C" android:endColor="#FFEC6E52" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
