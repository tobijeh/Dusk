<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dusk" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/dusk_background</item>
        <item name="android:colorBackground">@color/dusk_background</item>
        <item name="android:colorAccent">@color/dusk_accent</item>
        <item name="android:colorControlActivated">@color/dusk_accent</item>
        <item name="android:textColorPrimary">@color/dusk_text</item>
        <item name="android:textColorSecondary">@color/dusk_text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Dusk.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card</item>
    </style>

    <style name="Dusk.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Dusk.Chip" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:tint">@color/dusk_icon</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Dusk.RowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Dusk.Title" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dusk_text</item>
    </style>

    <style name="Dusk.Subtitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dusk_text_secondary</item>
    </style>

    <style name="Dusk.Trailing" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/dusk_text_secondary</item>
        <item name="android:src">@drawable/ic_chevron</item>
    </style>

    <style name="Dusk.Section" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/dusk_text_secondary</item>
    </style>
</resources>
